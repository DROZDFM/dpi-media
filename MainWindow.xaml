<Window x:Class="DpiMusicControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DPI Media"
        Icon="Assets/DpiMedia.ico"
        Width="558"
        Height="754"
        MinWidth="500"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="28"
                          ShadowDepth="8"
                          Opacity="0.38"
                          Color="#000000" />
    </Window.Resources>

    <Border Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="#2C3445"
            BorderThickness="1"
            CornerRadius="24"
            ClipToBounds="True"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#171B24"
                    CornerRadius="24,24,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="22,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="34"
                            Height="34"
                            Background="#302B57"
                            CornerRadius="11"
                            VerticalAlignment="Center">
                        <TextBlock Text="⌁"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="#AEA6FF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-4,0,0" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DPI Media" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Музыка — одним нажатием" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButton}"
                                Content="—"
                                ToolTip="Свернуть в трей"
                                Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource WindowButton}"
                                Content="×"
                                ToolTip="Свернуть в трей"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="22,20,22,18">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                            </Grid.ColumnDefinitions>

                            <Border Width="70"
                                    Height="70"
                                    CornerRadius="35"
                                    Background="#2C2854"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="HeroGlyph"
                                           Text="Ⅱ"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="31"
                                           FontWeight="SemiBold"
                                           Foreground="#AEA6FF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-2,0,0" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="DPI-кнопка управляет музыкой"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="HeroDetailText"
                                           Text="Mouse 4 → Воспроизвести / пауза"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleButton x:Name="EnabledToggle"
                                          Grid.Column="2"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          ToolTip="Включить или выключить сопоставление"
                                          Checked="EnabledToggle_Changed"
                                          Unchecked="EnabledToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Кнопка мыши" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Назначьте DPI или поймайте её сигнал"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        x:Name="StatusPill"
                                        Background="#203D38"
                                        CornerRadius="12"
                                        Padding="9,5"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StatusTitle"
                                                   Text="Активно"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   Margin="6,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,16,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="TriggerComboBox"
                                          Height="42"
                                          VerticalContentAlignment="Center"
                                          DisplayMemberPath="Title"
                                          SelectionChanged="TriggerComboBox_SelectionChanged" />
                                <Button x:Name="CaptureButton"
                                        Grid.Column="2"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="42"
                                        Content="Определить"
                                        Click="CaptureButton_Click" />
                            </Grid>

                            <Border x:Name="CaptureHintBorder"
                                    Background="#202633"
                                    CornerRadius="12"
                                    Padding="12,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#AFA6FF" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CaptureStatusText"
                                               Text="Готово. Нажмите «Определить», затем кнопку DPI."
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Действие" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Команда отправляется активному музыкальному приложению Windows"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#242B38"
                                        BorderBrush="#3A4355"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="13,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶" FontFamily="Segoe UI Symbol" Foreground="#AEA6FF" FontSize="14" />
                                        <TextBlock Text="Воспроизвести / пауза"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="9,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Проверить"
                                        Height="42"
                                        Click="TestButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Работа в фоне" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="При закрытии окно прячется в трей — управление остаётся включённым."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,3,10,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Запускать вместе с Windows"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="StartupToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Bottom"
                                          ToolTip="Добавить приложение в автозапуск"
                                          Checked="StartupToggle_Changed"
                                          Unchecked="StartupToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Background="#201E2D"
                            BorderBrush="#3C385B"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="i"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Не видит DPI-кнопку?"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#F0EAFE" />
                                <TextBlock Text="Если мышь поддерживает переназначение, задайте DPI-кнопке F13 или Mouse 4/5. Если нет (например, HP S1000 Plus), DPI аппаратная — выберите клик колёсика."
                                           FontSize="11"
                                           Foreground="#C2BAD7"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#171B24"
                    CornerRadius="0,0,24,24"
                    BorderBrush="#2B3241"
                    BorderThickness="0,1,0,0">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterStatusText"
                               Text="Сопоставление активно"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LastInputText"
                               Grid.Column="1"
                               Text="Ожидание нажатия"
                               FontSize="11"
                               Foreground="#8D97AC"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
